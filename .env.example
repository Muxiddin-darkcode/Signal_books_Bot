# Telegram Bot Token (@BotFather dan olinadi)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Adminlarning Telegram ID raqamlari (vergul bilan ajratilgan, masalan: 12345678,87654321)
# O'z ID raqamingizni bilish uchun Telegramda @userinfobot ga /start bosing
ADMIN_IDS=123456789

# Signal Books veb-sayti havolasi (HTTPS bo'lishi shart)
WEB_APP_URL=https://example.com

# --- Firebase Firestore Sozlamalari ---
# 1) Firebase xizmat kaliti fayl yo'li (agar serviceAccountKey.json loyiha papkasida bo'lsa, o'zgartirish shart emas)
FIREBASE_KEY_PATH=serviceAccountKey.json

# 2) Serverga (Render, Koyeb va h.k.) joylashtirganda fayl yuklamasdan to'g'ridan-to'g'ri
# Firebase JSON kalitining matnini (yoki Base64 formatini) quyidagi o'zgaruvchiga qo'yish mumkin:
# FIREBASE_CREDENTIALS={"type": "service_account", ...}

# Firebase'ni yoqish (true / false)
USE_FIREBASE=true
